# Normalize line endings for all text files.
* text=auto eol=lf

# Use Git LFS to manage large binary .wasm files in this folder (no diffs or merges).
# If LFS is not available, these files will be treated as binary and not diffed or merged.
# The `binary` macro sets -text, which overrides the `* text=auto` rule above.
playground/assets/wasm/*.wasm filter=lfs diff=lfs merge=lfs binary
